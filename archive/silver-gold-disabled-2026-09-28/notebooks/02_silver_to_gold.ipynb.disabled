    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import json, sys\n",
        "from pathlib import Path\n",
        "sys.path.insert(0, str(Path.cwd().parent))\n",
        "from azalea_pipeline.gold import publish_gold\n",
        "config = json.loads((Path.cwd().parent / \"deployment.json\").read_text())\n",
        "publish_gold(config[\"medallion_bucket\"], config[\"region\"])\n"
      ],
      "execution_count": null,
      "outputs": []
    }
