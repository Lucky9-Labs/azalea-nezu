      "source": [
        "# 02 \u00b7 Silver \u2192 gold\n",
        "Rebuild small synthetic gold snapshots from durable silver Parquet objects. Run after notebook 01.\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "%pip install -r ../requirements.txt\n"
      ],
