// Merge these entries into the existing tailnet policy. Do not replace other rules.
{
  "tagOwners": {
    "tag:azalea-notebook": ["autogroup:admin"],
    "tag:azalea-edge": ["autogroup:admin"],
    "tag:azalea-vps": ["autogroup:admin"]
  },
  "grants": [
    {"src": ["tag:azalea-notebook"], "dst": ["tag:azalea-edge", "tag:azalea-vps"], "ip": ["tcp:22"]},
    {"src": ["tag:azalea-edge"], "dst": ["tag:azalea-vps"], "ip": ["tcp:3900"]}
  ],
  "ssh": [
    {"action": "accept", "src": ["tag:azalea-notebook"], "dst": ["tag:azalea-edge", "tag:azalea-vps"], "users": ["azalea-read"]}
  ]
}
